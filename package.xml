<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_rpil_ros</name>
  <version>0.7.2</version>
  <description>libcamera camera node for Raspberry Pi cameras (e.g. IMX219) on ROS 2 Lyrical / Ubuntu 26.04, derived from camera_ros 0.7.0 with workarounds for a Raspberry Pi IPA crash (no initial control list, runtime parameter merging disabled)</description>
  <maintainer email="arlunan@ieee.org">arlunan</maintainer>
  <license>MIT</license>

  <author email="Rauch.Christian@gmx.de">Christian Rauch (original camera_ros)</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend version_gte="0.1">libcamera</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>camera_info_manager</depend>
  <depend>cv_bridge</depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend condition="$ROS_DISTRO != 'humble'">image_view</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>clang-format</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_mypy</test_depend>
  <test_depend>ament_cmake_pep257</test_depend>
  <test_depend>ament_cmake_pyflakes</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
